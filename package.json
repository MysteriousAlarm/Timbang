{
  "name": "timbang-root",
  "private": true,
  "description": "Project TIMBANG: rules tests and dev scripts",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-timbang \"jest --config tests/rules/jest.config.js --runInBand\"",
    "emulators": "firebase emulators:start --project demo-timbang --import=./emulator-data --export-on-exit",
    "seed:admin": "node scripts/set-admin.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "jest": "^29.7.0"
  }
}
